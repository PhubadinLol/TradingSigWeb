# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored — never commit real API keys.

# ---------------------------------------------------------------
# Market data provider
#   mock       — deterministic demo data (default, no key needed).
#                The UI shows a "Demo Data" banner in this mode.
#   binance    — real crypto candles from Binance's public REST API
#                (no key required; crypto symbols only).
#   twelvedata — real forex, metals and crypto candles from Twelve Data
#                (requires TWELVE_DATA_API_KEY).
# ---------------------------------------------------------------
MARKET_DATA_PROVIDER=mock

# Twelve Data API key — get one at https://twelvedata.com
TWELVE_DATA_API_KEY=

# Optional: override the Binance REST host (e.g. https://api.binance.us)
BINANCE_BASE_URL=https://api.binance.com

# ---------------------------------------------------------------
# Signal thresholds (optional). Format: strongBuy,buy,sell,strongSell
# Default: 60,30,-30,-60
# ---------------------------------------------------------------
SIGNAL_THRESHOLDS=60,30,-30,-60
